# --- Telegram ---
# From @BotFather. Required; the bot refuses to start without it.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram chat_ids allowed to use admin-only commands.
# Find yours by messaging the bot and reading the logs, or via @userinfobot.
ADMIN_CHAT_IDS=

# --- Storage ---
# Local file by default. On Railway point this at a mounted volume,
# e.g. /data/bot.db — otherwise the database is wiped on every deploy.
DATABASE_PATH=./bot.db

# --- Logging ---
LOG_LEVEL=INFO

# --- Optional: Claude ---
# Leave empty to run without AI. Must be plain ASCII: a key pasted with
# smart quotes or a stray newline makes every call fail deep inside the SDK
# with no clear error, so config.py checks it at startup instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Рыночные данные (публичные API, ключи не нужны) ---
COINGECKO_ID=internet-computer
COINBASE_PRODUCT=ICP-USD
POLL_INTERVAL_SECONDS=60

# Пороги уведомлений задаются в alert_levels.py, а не здесь: это логика.

# --- Доставка ---
# Группа или канал, куда дублировать уведомления и сводку.
# Пусто — только личные подписчики.
TELEGRAM_CHAT_ID=

# Часовой пояс для показа времени и час ежедневной сводки.
DISPLAY_TZ=Asia/Tashkent
DIGEST_HOUR=9
